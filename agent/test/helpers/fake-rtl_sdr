#!/usr/bin/env node
'use strict';
// A stand-in for rtl_sdr: takes the same arguments, says on stderr what a real
// RTL-SDR Blog V4 says, and streams u8 IQ to stdout in real time — noise, with
// an ALERT Binary burst (two frames) at its stick's channel every few seconds,
// or a burst on each of several channels.
//
// It plays librtlsdr too, as far as the agent can tell. It finds the sticks in
// the fake sysfs (RPI_ALERT_SYSFS), numbers them as libusb does (in reverse
// device-path order), lists them, picks one from -d as rtl_sdr does (a number;
// else a serial — exact, prefix, suffix), refuses a stick another rtl_sdr holds
// ("usb_claim_interface error -6"), holds that stick's /dev/bus/usb/BBB/DDD
// node open (under RPI_ALERT_DEV) as libusb does, and exits as on an unplug
// when the stick's sysfs entry goes away. With no fake sysfs: one stick. Its
// options are the real one's, and nothing else: anything more (-T, which no
// rtl_sdr has) is its usage and exit 1, as getopt "d:f:g:s:b:n:p:SD" answers.
//
// Linked as rtl_biast, it is that instead (getopt "d:b:g:h?"): it finds the
// stick from -d as rtl_sdr would, opens it — refused while an rtl_sdr holds it
// — and appends "<USB port> <-b>" to RPI_ALERT_FAKE_BIAST_LOG.
//
//   RPI_ALERT_FAKE_CHANNEL_HZ=151500000          where the bursts are (default 151.5 MHz)
//   RPI_ALERT_FAKE_FRAMES="2088:143,2089:12"     what they carry
//   RPI_ALERT_FAKE_STICKS='{"1-1.4": {"channelHz": 151600000, "frames": "3001:77"}}'
//                                                 per stick, by USB port
//   RPI_ALERT_FAKE_BURSTS='[{"channelHz": 152400000, "frames": "4001:5", "format": "ENHANCED_IFLOWS"}, …]'
//                                                 a burst on each of several channels, one after
//                                                 another (also per stick: "bursts": […]); a burst
//                                                 out of the slice rtl_sdr was told to tune is not sent
//   RPI_ALERT_FAKE_ALERT2='[{"channelHz": 151537500, "startSec": 4, "cfoHz": 2800, "inverted": true,
//       "pdus": [{"source": 33300, "path": [10019], "stamp": "now", "records": [{"id": 1909, "value": 38, "before": 52}]}]}]'
//                                                 ALERT2 frames too (test/helpers/alert2-tx.js; also per
//                                                 stick: "alert2": […]); a stamp "now" is the time it starts
//   RPI_ALERT_FAKE_FORMAT=BINARY|ENHANCED_IFLOWS
//   RPI_ALERT_FAKE_ORDER=forward                  number the sticks in device-path order,
//                                                 unlike libusb (the agent must notice)
//   RPI_ALERT_FAKE_EXIT_AFTER_S=5                 exit (as an unplug would) after this long

const fs = require('node:fs');
const path = require('node:path');
const D = require(path.join(__dirname, '..', '..', 'vendor', 'meganet', 'alert-dsp.js'));
const { RTL_IDS } = require(path.join(__dirname, '..', '..', 'lib', 'serial', 'scan.js'));

const a = process.argv.slice(2);
const SYS = process.env.RPI_ALERT_SYSFS;
const DEV = process.env.RPI_ALERT_DEV;
const err = (s) => process.stderr.write(s);
const read = (p) => { try { return fs.readFileSync(p, 'utf8').trim(); } catch (_) { return ''; } };
const BIAST = path.basename(process.argv[1]) === 'rtl_biast';

// getopt(argc, argv, spec): every option it is given, or its usage and exit 1.
const USAGE = BIAST
  ? 'rtl_biast, a tool for turning the RTL-SDR.com \nbias tee or any GPIO ON and OFF. Example to turn on the \nbias tee: rtl_biast -d 0 -b 1\n'
    + 'Any GPIO: rtl_biast -d 0 -g 1 -b 1\n\nUsage:\n\t[-d device_index (default: 0)]\n\t[-b bias_on (default: 0)]\n\t[-g GPIO select (default: 0)]\n'
  : 'rtl_sdr, an I/Q recorder for RTL2832 based DVB-T receivers\n\nUsage:\t -f frequency_to_tune_to [Hz]\n\t[-s samplerate (default: 2048000 Hz)]\n'
    + '\t[-d device_index or serial (default: 0)]\n\t[-g gain (default: 0 for auto)]\n\t[-p ppm_error (default: 0)]\n\t[-b output_block_size (default: 16 * 16384)]\n'
    + '\t[-n number of samples to read (default: 0, infinite)]\n\t[-S force sync output (default: async)]\n\t[-D enable direct sampling (default: off)]\n'
    + '\tfilename (a \'-\' dumps samples to stdout)\n\n';
function getopt(spec) {
  const out = {};
  for (let i = 0; i < a.length; i++) {
    const m = /^-(.)$/.exec(a[i]);
    if (!m) continue;                                   // the filename ("-" is one)
    const k = spec.indexOf(m[1]);
    if (k < 0 || m[1] === ':') { err(path.basename(process.argv[1]) + ': invalid option -- \'' + m[1] + '\'\n' + USAGE); process.exit(1); }
    out[m[1]] = spec[k + 1] === ':' ? a[++i] : true;
  }
  return out;
}
const opts = getopt(BIAST ? 'd:b:g:h?' : 'd:f:g:s:b:n:p:SD');
const arg = (k, d) => (opts[k.slice(1)] !== undefined ? opts[k.slice(1)] : d);
const rate = Number(arg('-s', 2048000));
const center = Number(arg('-f', 100e6));

function sticks() {
  if (!SYS) return [{ busPath: null, manufacturer: 'RTLSDRBlog', product: 'Blog V4', serial: '00000001' }];
  const root = path.join(SYS, 'bus', 'usb', 'devices');
  let names = [];
  try { names = fs.readdirSync(root).filter(n => !n.includes(':')); } catch (_) {}
  const out = names.map(n => ({ busPath: n, dir: path.join(root, n) }))
    .filter(s => RTL_IDS.has(read(path.join(s.dir, 'idVendor')) + ':' + read(path.join(s.dir, 'idProduct'))))
    .map(s => Object.assign(s, { manufacturer: read(path.join(s.dir, 'manufacturer')), product: read(path.join(s.dir, 'product')), serial: read(path.join(s.dir, 'serial')),
      busnum: Number(read(path.join(s.dir, 'busnum'))), devnum: Number(read(path.join(s.dir, 'devnum'))) }));
  // libusb: udev lists devices in device-path order, and each found goes to the head of the list.
  out.sort((x, y) => (x.busPath < y.busPath ? -1 : x.busPath > y.busPath ? 1 : 0));
  if (process.env.RPI_ALERT_FAKE_ORDER !== 'forward') out.reverse();
  return out;
}

// strtol(s, &end, 0) when it reads all of s, else null.
function strtol0(s) {
  const m = /^\s*([+-]?)(0[xX][0-9a-fA-F]+|0[0-7]*|[1-9][0-9]*)$/.exec(s);
  if (!m) return null;
  const t = m[2];
  const v = /^0[xX]/.test(t) ? parseInt(t, 16) : t.length > 1 && t[0] === '0' ? parseInt(t, 8) : parseInt(t, 10);
  return m[1] === '-' ? -v : v;
}

// rtl_sdr's verbose_device_search().
function search(q, list) {
  if (!list.length) { err('No supported devices found.\n'); return -1; }
  err('Found ' + list.length + ' device(s):\n');
  list.forEach((d, i) => err('  ' + i + ':  ' + d.manufacturer + ', ' + d.product + ', SN: ' + d.serial + '\n'));
  err('\n');
  const n = strtol0(q);
  let i = n !== null && n >= 0 && n < list.length ? n : -1;
  for (const hit of [(s) => s === q, (s) => s.startsWith(q), (s) => s.endsWith(q)]) if (i < 0) i = list.findIndex(d => hit(d.serial));
  if (i < 0) { err('No matching devices found.\n'); return -1; }
  err('Using device ' + i + ': Generic RTL2832U OEM\n');
  return i;
}

// usbfs allows one claim on a stick's interface: a lock file, by pid.
function claim(lock) {
  for (let tries = 0; tries < 2; tries++) {
    try { const fd = fs.openSync(lock, 'wx'); fs.writeSync(fd, String(process.pid)); fs.closeSync(fd); return true; } catch (e) { if (e.code !== 'EEXIST') throw e; }
    const pid = Number(read(lock));
    let alive = !pid;                                   // empty: being written right now
    if (pid) { try { process.kill(pid, 0); alive = true; } catch (_) {} }
    if (alive) return false;
    try { fs.unlinkSync(lock); } catch (_) {}
  }
  return false;
}

const list = sticks();
const index = search(arg('-d', '0'), list);
if (index < 0) process.exit(1);
const st = list[index];
if (DEV && st.busPath) {
  const node = path.join(DEV, 'bus', 'usb', String(st.busnum).padStart(3, '0'), String(st.devnum).padStart(3, '0'));
  fs.mkdirSync(path.dirname(node), { recursive: true });
  if (!claim(node + '.claimed')) { err('usb_claim_interface error -6\nFailed to open rtlsdr device #' + index + '.\n'); process.exit(1); }
  process.on('exit', () => { try { if (Number(read(node + '.claimed')) === process.pid) fs.unlinkSync(node + '.claimed'); } catch (_) {} });
  fs.openSync(node, 'a+');                              // held open, as libusb holds the device node
  setInterval(() => { if (!fs.existsSync(st.dir)) { err('cb transfer status: 5, canceling...\nLibrary error -5, exiting...\n'); process.exit(1); } }, 300);
}
if (BIAST) {
  if (process.env.RPI_ALERT_FAKE_BIAST_LOG) fs.appendFileSync(process.env.RPI_ALERT_FAKE_BIAST_LOG, (st.busPath || '-') + ' ' + arg('-b', '0') + '\n');
  process.exit(0);
}

let per = {}, many = null;
try { per = JSON.parse(process.env.RPI_ALERT_FAKE_STICKS || '{}'); } catch (_) {}
try { many = JSON.parse(process.env.RPI_ALERT_FAKE_BURSTS || 'null'); } catch (_) {}
const mine = (st.busPath && per[st.busPath]) || {};
const frameList = (s, fmt) => s.split(',').map(p => p.split(':').map(Number)).map(([id, v]) => D.encodeFrame(D[fmt], id, v));
const want = mine.bursts || many || [{ channelHz: mine.channelHz || process.env.RPI_ALERT_FAKE_CHANNEL_HZ || 151.5e6,
  frames: mine.frames || process.env.RPI_ALERT_FAKE_FRAMES || '2088:143,2089:12', format: mine.format || process.env.RPI_ALERT_FAKE_FORMAT || 'BINARY' }];

// A stick whose crystal is `ppmError` ppm fast tunes high, so what it hears
// arrives low — less whatever rtl_sdr -p corrects.
const ppmOff = Number(mine.ppmError || 0) - Number(arg('-p', '0'));

err('Found Rafael Micro R828D tuner\nRTL-SDR Blog V4 Detected\nSampling at ' + rate + ' S/s.\nTuned to ' + center + ' Hz.\nReading samples in async mode...\n');

// One burst a channel, a second and a half apart (or at its own startSec, to
// overlap), then quiet: the loop lasts at least six seconds — eleven with
// several, so that each comes round again as a new reading (the decoder takes
// the same reading within ten seconds for a repeat). Only what falls inside
// the slice rtl_sdr was told to tune is on the air here.
const bursts = want.map((b, i) => ({ startSec: b.startSec != null ? Number(b.startSec) : 2.0 + 1.5 * i, frames: frameList(String(b.frames), b.format || 'BINARY'),
  cfoHz: Number(b.channelHz) - center - ppmOff * Number(b.channelHz) / 1e6, amp: 40, polarity: 'NEG' }))
  .filter(b => Math.abs(b.cfoHz) < rate / 2 - 15000);
const seconds = Math.max(want.length > 1 ? 11 : 6, ...bursts.map(b => b.startSec + 3));
const loop = D.synthIq({ fs: rate, seconds, snrDb: 28, seed: 7, bursts });

// ALERT2 frames, added to the noise and the legacy bursts.
let alert2 = mine.alert2 || null;
try { if (!alert2) alert2 = JSON.parse(process.env.RPI_ALERT_FAKE_ALERT2 || 'null'); } catch (_) {}
if (alert2 && alert2.length) {
  const Tx = require(path.join(__dirname, 'alert2-tx.js'));
  const n = loop.length >> 1, re = new Float32Array(n), im = new Float32Array(n);
  for (const f of alert2) {
    const cfoHz = Number(f.channelHz) - center - ppmOff * Number(f.channelHz) / 1e6 + Number(f.cfoHz || 0);
    if (Math.abs(cfoHz) >= rate / 2 - 15000) continue;
    const pdus = f.pdus.map(p => Object.assign({}, p, { stamp: p.stamp === 'now' ? Tx.stampOf(Date.now()) : p.stamp }));
    Tx.addFrame(re, im, rate, Math.round(Number(f.startSec || 4) * rate), { pdus, cfoHz, inverted: !!f.inverted, amp: 40 });
  }
  for (let i = 0; i < n; i++) {
    if (!re[i] && !im[i]) continue;
    loop[2 * i] = Math.max(0, Math.min(255, Math.round(loop[2 * i] + re[i])));
    loop[2 * i + 1] = Math.max(0, Math.min(255, Math.round(loop[2 * i + 1] + im[i])));
  }
}

const chunk = Math.round(rate / 20) * 2;   // 50 ms
let pos = 0;
const t0 = Date.now();
let sent = 0;
const exitAfter = Number(process.env.RPI_ALERT_FAKE_EXIT_AFTER_S || 0);
function pump() {
  if (exitAfter && Date.now() - t0 > exitAfter * 1000) { err('cb transfer status: 5, canceling...\nLibrary error -5, exiting...\n'); process.exit(1); }
  const due = ((Date.now() - t0) / 1000) * rate * 2;
  while (sent < due) {
    const end = Math.min(loop.length, pos + chunk);
    // write() takes the chunk even when it answers false (Node 18 answers
    // false for any chunk over the high-water mark): count it either way.
    const ok = process.stdout.write(Buffer.from(loop.subarray(pos, end)));
    sent += end - pos;
    pos = end >= loop.length ? 0 : end;
    if (!ok) { process.stdout.once('drain', pump); return; }
  }
  setTimeout(pump, 25);
}
process.stdout.on('error', () => process.exit(0));
process.on('SIGTERM', () => { err('Signal caught, exiting!\n'); process.exit(0); });
pump();
