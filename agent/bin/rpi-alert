#!/usr/bin/env node
'use strict';
// rpi-alert — the RPi ALERT agent, and the command to look at and set it up.
//
//   rpi-alert daemon                 run the agent (systemd does this: rpi-alert.service)
//   rpi-alert status                 what is connected, what is being heard, is MegaNet getting it
//   rpi-alert top                    the same, live, until Ctrl+C
//   rpi-alert setup                  questions for the essentials: token, name, location, radio
//   rpi-alert request-token          ask MegaNet for this Pi's token: shows a code and a QR code,
//                                    an administrator approves it on MegaNet's Admin tab, and it
//                                    is saved by itself (--cancel stops asking; --invert for a
//                                    terminal with a light background)
//   rpi-alert token [mgn_…]          set (or check) the MegaNet ingest token by hand
//   rpi-alert config get [key]       print settings (e.g. receivers.sdr.freqHz)
//   rpi-alert config set key value   change one (value as JSON, or plain text)
//   rpi-alert sdr                    the RTL-SDR sticks: number, name, channel, USB port, state
//   rpi-alert sdr <stick> <setting> <value>
//                                    a stick's own setting: freq (MHz), format, gain (dB or
//                                    auto), ppm, squelch, bias-tee, name; or on / off. The value
//                                    "shared" goes back to the setting all sticks share.
//                                    <stick>: its number (2 for "RTL-SDR 2"), name or USB port
//   rpi-alert sdr remove <stick>     forget an unplugged stick: name, settings, MegaNet receiver id
//   rpi-alert password               set the web page password
//   rpi-alert readings [n]           the last n readings
//   rpi-alert log [n]                the agent's recent log (journalctl -u rpi-alert for all of it)
//   rpi-alert test-audio [alert|alert2|beep]
//   rpi-alert send-now               retry MegaNet now (skip any back-off)
//   rpi-alert import-boot-config     apply /boot/firmware/rpi-alert.conf (root; done at every boot)
//   rpi-alert version
//
// Everything but `daemon` and `import-boot-config` talks to the running agent
// on http://127.0.0.1 — over SSH (PuTTY on Windows) that is all a headless
// base station needs.

const path = require('node:path');
const lib = path.join(__dirname, '..', 'lib');
const pkg = require('../package.json');

const argv = process.argv.slice(2);
const cmd = argv[0] || 'help';

async function main() {
  switch (cmd) {
    case 'daemon': return daemon();
    case 'status': return status(argv.includes('--json'));
    case 'top': return top();
    case 'setup': return setup();
    case 'token': return token(argv[1]);
    case 'request-token': case 'pair': return requestToken({ cancel: argv.includes('--cancel'), invert: argv.includes('--invert') });
    case 'config': return config(argv[1], argv[2], argv.slice(3).join(' '));
    case 'sdr': case 'sdrs': return sdr(argv.slice(1));
    case 'password': return password();
    case 'readings': return readings(Number(argv[1]) || 20);
    case 'log': case 'logs': return showLog(Number(argv[1]) || 60);
    case 'test-audio': return post('/api/audio/test', { kind: argv[1] || 'alert' }).then(() => console.log('Playing a test chirp.'));
    case 'send-now': return post('/api/send-now', {}).then(() => console.log('Retrying MegaNet now.'));
    case 'import-boot-config': return require(path.join(lib, 'bootconf')).main(argv.slice(1));
    case 'version': case '--version': case '-v': console.log(pkg.version); return;
    default: return help();
  }
}

function help() {
  const src = require('node:fs').readFileSync(__filename, 'utf8').split('\n');
  const start = src.findIndex(l => l.includes('rpi-alert daemon'));
  console.log('RPi ALERT ' + pkg.version + '\n');
  for (let i = start; i < src.length && src[i].startsWith('//'); i++) console.log(src[i].replace(/^\/\/ ?/, ''));
}

// ── the daemon ───────────────────────────────────────────────────────────────

function daemon() {
  const { Agent } = require(path.join(lib, 'agent'));
  const { WebServer } = require(path.join(lib, 'web', 'server'));
  const agent = new Agent().start();
  const web = new WebServer(agent).start();
  let stopping = false;
  const stop = async (sig) => {
    if (stopping) return;
    stopping = true;
    agent.log.info('stopping (' + sig + ')');
    web.stop();
    try { await agent.stop(); } catch (_) {}
    process.exit(0);
  };
  process.on('SIGTERM', () => stop('SIGTERM'));
  process.on('SIGINT', () => stop('SIGINT'));
  process.on('uncaughtException', (e) => { agent.log.error('uncaught: ' + (e && e.stack || e)); try { agent.uplink.persistNow(); } catch (_) {} process.exit(1); });
  process.on('unhandledRejection', (e) => { agent.log.error('unhandled rejection: ' + (e && e.stack || e)); });
}

// ── talking to the running agent ─────────────────────────────────────────────

const PORTS = process.env.RPI_ALERT_PORT ? [Number(process.env.RPI_ALERT_PORT)] : [80, 8080];
let base = null;

async function api(p, opts) {
  const tryOne = async (port) => {
    const res = await fetch('http://127.0.0.1:' + port + p, Object.assign({ signal: AbortSignal.timeout(15000) }, opts || {}));
    const text = await res.text();
    let body = null;
    try { body = JSON.parse(text); } catch (_) {}
    if (!body) throw Object.assign(new Error('not the RPi ALERT agent on port ' + port), { notAgent: true });
    if (!res.ok) throw new Error(body.error || ('HTTP ' + res.status));
    return body;
  };
  if (base) return tryOne(base);
  let last;
  for (const port of PORTS) {
    try { const b = await tryOne(port); base = port; return b; } catch (e) { last = e; if (!(e.notAgent || (e.cause && e.cause.code === 'ECONNREFUSED'))) throw e; }
  }
  throw new Error('the agent is not running (sudo systemctl status rpi-alert; sudo journalctl -u rpi-alert -e)' + (last ? ' — ' + (last.cause && last.cause.code || last.message) : ''));
}
function post(p, body) { return api(p, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }); }

// ── status ───────────────────────────────────────────────────────────────────

const C = process.stdout.isTTY ? { b: '\x1b[1m', d: '\x1b[2m', g: '\x1b[32m', y: '\x1b[33m', r: '\x1b[31m', c: '\x1b[36m', x: '\x1b[0m' }
  : { b: '', d: '', g: '', y: '', r: '', c: '', x: '' };

function ago(ms) {
  if (ms == null) return '—';
  const s = Math.round(ms / 1000);
  return s < 60 ? s + ' s ago' : s < 3600 ? Math.round(s / 60) + ' min ago' : Math.round(s / 3600) + ' h ago';
}

function render(s, readingsList) {
  const out = [];
  const m = s.meganet;
  out.push(C.b + 'RPi ALERT ' + s.version + C.x + '  ' + s.name + C.d + '  (' + s.system.hostname + ', ' + (s.system.addresses || []).map(a => a.address).join(' ') + ')' + C.x);
  const tr = s.tokenRequest || {};
  const up = tr.state === 'pending' ? C.y + 'waiting for an administrator to approve this Pi\'s token'
    : m.tokenRefused ? C.r + 'token refused (rpi-alert request-token)' : !m.tokenSet ? C.y + 'no token set (rpi-alert request-token)' : !m.enabled ? C.y + 'sending off'
    : m.lastError ? C.y + 'retrying' : C.g + 'ok';
  out.push('MegaNet   ' + up + C.x + C.d + (m.label ? '  as "' + m.label + '"' : '') + C.x + '  stored ' + m.accepted + ', dup ' + m.duplicates + ', refused ' + m.rejected
    + ', waiting ' + m.queued + (m.waitingForClock ? ' (+' + m.waitingForClock + ' for the clock)' : '') + (m.lastOkAt ? C.d + ', last ' + ago(Date.now() - m.lastOkAt) + C.x : ''));
  if (tr.state === 'pending') {
    out.push('          code ' + C.b + tr.code + C.x + ' — on MegaNet: Admin → Ingest tokens → Approve (expires in ' + Math.max(1, Math.round(tr.expiresInS / 60)) + ' min; QR code: rpi-alert request-token)');
  } else if (tr.last && tr.last.status !== 'approved' && Date.now() - tr.last.at < 3600000) out.push('          ' + C.y + tr.last.message + C.x);
  if (m.lastError && tr.state !== 'pending') out.push('          ' + C.y + m.lastError + C.x);
  out.push('Clock     ' + (s.clock.trusted ? C.g + 'ok (' + s.clock.source + ')' : C.y + 'not yet trusted — readings are held until NTP or GPS sets it') + C.x + C.d + '  ' + s.clock.now + ' ' + s.clock.timezone + C.x);
  const loc = s.location;
  out.push('Location  ' + (loc.source === 'none' ? C.y + 'not set' + C.x : loc.source + (loc.lat != null ? ' ' + loc.lat.toFixed(5) + ', ' + loc.lon.toFixed(5) : '')));
  if (s.system.power && (s.system.power.underVoltageNow || s.system.power.underVoltageSinceBoot)) out.push(C.r + 'Power     under-voltage detected — use a proper 5 V supply; USB receivers drop out on a weak one' + C.x);
  out.push('');
  out.push(C.b + 'Receivers' + C.x);
  const devs = [...s.devices.ports, ...s.devices.sdrs];
  if (!devs.length) out.push('  ' + C.y + 'none found — plug in an RTL-SDR, a Quansheng radio (USB-C), an ERT-A2 (USB-serial) or a GPS' + C.x);
  for (const d of devs) {
    const col = d.state === 'running' ? C.g : d.state === 'identifying' || d.state === 'starting' ? C.c : C.y;
    let line = '  ' + col + d.state.padEnd(12) + C.x + ' ' + d.name.padEnd(22) + ' ' + (d.protocol ? (d.protocol === 'alert2' ? 'ALERT2' : 'ALERT ') : '      ');
    if (d.kind === 'sdr') {
      line += C.d + ' ' + (d.freqHz / 1e6).toFixed(4) + ' MHz ' + d.format + (s.devices.sdrs.length > 1 || d.state === 'unplugged' ? ', USB port ' + d.device.port : '');
      line += d.state === 'unplugged' ? (d.lastSeen ? ', last seen ' + ago(Date.now() - d.lastSeen) : '') + ' (rpi-alert sdr remove ' + d.n + ' forgets it)' + C.x
        : (d.tuner ? ' ' + d.tuner : '') + (d.level ? ' ch ' + d.level.chDb + ' dB, floor ' + d.level.nfDb + ' dB' : '') + ', bursts ' + d.counts.bursts + ', decodes ' + d.counts.decodes + C.x;
    } else {
      line += C.d + ' ' + d.port.dev + (d.port.baud ? ' @' + d.port.baud : '') + (d.how ? ' — ' + d.how : '') + C.x;
      const q = d.detail || {};
      if (d.kind === 'quansheng' && q.battery) line += C.d + ', batt ' + q.battery.pct + '%, nf ' + q.nf_dbm + ' dBm' + C.x;
      if (d.kind === 'gps') line += C.d + (q.fix ? ', fix ' + (q.fix.lat != null ? q.fix.lat.toFixed(5) + ', ' + q.fix.lon.toFixed(5) : '(hidden)') + ' ±' + q.fix.accuracy_m + ' m, ' + q.sats + ' sats' : ', no fix') + C.x;
    }
    if (d.error) line += ' ' + C.y + d.error + C.x;
    out.push(line);
  }
  if (readingsList) {
    out.push('');
    out.push(C.b + 'Latest readings' + C.x);
    if (!readingsList.length) out.push('  ' + C.d + 'nothing heard yet' + C.x);
    for (const r of readingsList) {
      out.push('  ' + new Date(r.t).toLocaleTimeString() + '  ' + (r.protocol === 'alert2' ? 'ALERT2' : 'ALERT ') + ' ' + String(r.fmt || '').padEnd(6) + String(r.alert_id).padStart(5)
        + ' = ' + String(r.eng).padEnd(10) + ' ' + ((r.station && r.station.name) || '').slice(0, 28).padEnd(28) + C.d + ' ' + r.receiver + (r.rssi_dbm != null ? ' ' + r.rssi_dbm + ' dBm' : '') + (r.votes != null ? ' ' + r.votes + ' votes' : '') + (r.snr_db != null ? ' SNR ' + Math.round(r.snr_db) + ' dB' : '') + (r.timed ? '' : ' (waiting for clock)') + C.x);
    }
  }
  return out.join('\n');
}

async function status(json) {
  const s = await api('/api/status');
  if (json) { console.log(JSON.stringify(s, null, 2)); return; }
  const r = await api('/api/readings?limit=10');
  console.log(render(s, r.readings));
  if (!s.passwordSet) console.log('\n' + C.y + 'No web password yet: anyone on this network can change settings at http://' + s.system.hostname + '.local/ — set one with: rpi-alert password' + C.x);
}

async function top() {
  const draw = async () => {
    try {
      const [s, r] = await Promise.all([api('/api/status'), api('/api/readings?limit=' + Math.max(5, (process.stdout.rows || 40) - 20))]);
      process.stdout.write('\x1b[H\x1b[2J' + render(s, r.readings) + '\n\n' + C.d + 'Ctrl+C to quit' + C.x + '\n');
    } catch (e) { process.stdout.write('\x1b[H\x1b[2J' + e.message + '\n'); }
  };
  await draw();
  setInterval(draw, 2000);
}

// ── settings ─────────────────────────────────────────────────────────────────

function getPath(o, p) { return !p ? o : p.split('.').reduce((a, k) => (a == null ? undefined : a[k]), o); }
function patchFor(p, v) { const out = {}; let cur = out; const ks = p.split('.'); ks.slice(0, -1).forEach(k => { cur = cur[k] = {}; }); cur[ks[ks.length - 1]] = v; return out; }

async function config(sub, key, value) {
  if (sub === 'get' || !sub) {
    const c = (await api('/api/config')).config;
    const v = getPath(c, key);
    console.log(typeof v === 'object' ? JSON.stringify(v, null, 2) : String(v));
    return;
  }
  if (sub === 'set') {
    if (!key) throw new Error('rpi-alert config set <key> <value>');
    let v = value;
    try { v = JSON.parse(value); } catch (_) {}
    const r = await post('/api/config', { config: patchFor(key, v) });
    console.log(r.changed.length ? 'Saved: ' + r.changed.join(', ') : 'Unchanged.');
    return;
  }
  throw new Error('rpi-alert config get [key] | set <key> <value>');
}

// ── RTL-SDR sticks ───────────────────────────────────────────────────────────

const FORMATS = { BINARY: 'ALERT Binary', ENHANCED_IFLOWS: 'Enhanced iFLOWS', ASCII: 'ALERT ASCII' };
const STICK_SETTINGS = {
  freq: 'freqHz', frequency: 'freqHz', mhz: 'freqHz', format: 'format', gain: 'gainDb', ppm: 'ppm', squelch: 'squelchDb',
  'bias-tee': 'biasTee', biastee: 'biasTee', bias: 'biasTee', name: 'name', enabled: 'enabled',
};
const yes = (v) => /^(1|y|yes|on|true)$/i.test(v), no = (v) => /^(0|n|no|off|false)$/i.test(v);

// A stick by its number (2 for "RTL-SDR 2"), name, USB port or key.
function pickStick(sticks, ref) {
  const which = sticks.map(d => d.n + ' (' + d.name + ', USB port ' + d.device.port + ')').join(', ') || 'none known';
  if (!ref) throw new Error('which stick? ' + which);
  const r = String(ref).toLowerCase();
  for (const hit of [d => d.key === ref, d => d.device.port === ref, d => String(d.n) === r || 'sdr' + d.n === r, d => d.name.toLowerCase() === r]) {
    const found = sticks.filter(hit);
    if (found.length === 1) return found[0];
    if (found.length > 1) throw new Error('"' + ref + '" is more than one stick: ' + which);
  }
  throw new Error('no stick "' + ref + '" — ' + which);
}

// A setting's value as typed → the settings' own; undefined: back to the shared setting.
function stickValue(field, s) {
  s = String(s || '').trim();
  if (/^(shared|default|same)$/i.test(s)) return undefined;
  const number = (what) => { const n = Number(s); if (s === '' || !Number.isFinite(n)) throw new Error(what); return n; };
  switch (field) {
    case 'freqHz': { const n = number('freq: a frequency in MHz, e.g. 151.525'); return Math.round(n >= 1e6 ? n : n * 1e6); }
    case 'format': {
      const f = { binary: 'BINARY', abf: 'BINARY', enhanced_iflows: 'ENHANCED_IFLOWS', iflows: 'ENHANCED_IFLOWS', eif: 'ENHANCED_IFLOWS', ascii: 'ASCII' }[s.toLowerCase().replace(/[\s-]+/g, '_')];
      if (!f) throw new Error('format: binary, enhanced_iflows or ascii');
      return f;
    }
    case 'gainDb': return /^(auto|agc)$/i.test(s) ? null : number('gain: a number of dB, or auto');
    case 'ppm': return number('ppm: a number, e.g. -3');
    case 'squelchDb': return number('squelch: dB over the noise floor, e.g. 8');
    case 'biasTee': case 'enabled': if (yes(s)) return true; if (no(s)) return false; throw new Error(field === 'biasTee' ? 'bias-tee: on or off' : 'on or off');
    default: return s || undefined;
  }
}

function printSticks(sticks) {
  if (!sticks.length) { console.log(C.y + 'No RTL-SDR sticks yet — plug one in.' + C.x); return; }
  console.log(C.b + 'RTL-SDR sticks' + C.x);
  for (const d of sticks) {
    const own = (f) => (d.own.includes(f) ? '*' : ' ');
    const col = d.state === 'running' ? C.g : d.state === 'unplugged' ? C.y : C.c;
    console.log('  ' + String(d.n).padStart(2) + '  ' + d.name.padEnd(14) + ' ' + col + d.state.padEnd(10) + C.x + ' '
      + (d.freqHz / 1e6).toFixed(4) + ' MHz' + own('freqHz') + ' ' + (FORMATS[d.format] + own('format')).padEnd(17)
      + ' USB port ' + String(d.device.port).padEnd(8) + C.d + ' SN ' + (d.device.serial || '—') + ' · ' + d.pointId
      + (d.state === 'unplugged' && d.lastSeen ? ' · last seen ' + ago(Date.now() - d.lastSeen) : '') + C.x);
  }
  if (sticks.some(d => d.own.length)) console.log(C.d + '  * its own setting (the rest: rpi-alert config get receivers.sdr)' + C.x);
  console.log('\nA stick\'s own channel: rpi-alert sdr ' + (sticks[1] || sticks[0]).n + ' freq 151.525   (also format, gain, ppm, squelch, bias-tee, name, on, off; "shared" undoes one)');
  if (sticks.some(d => d.state === 'unplugged')) console.log('Forget one that is unplugged: rpi-alert sdr remove ' + sticks.find(d => d.state === 'unplugged').n);
}

async function sdr(args) {
  const sticks = (await api('/api/status')).devices.sdrs;
  if (!args.length || args[0] === 'list') return printSticks(sticks);
  if (args[0] === 'remove' || args[0] === 'forget') {
    const d = pickStick(sticks, args[1]);
    const r = await post('/api/devices/forget', { key: d.key });
    console.log('Removed ' + r.name + '. Plugged in again, it is found as a new receiver.');
    return;
  }
  const d = pickStick(sticks, args[0]);
  let what = String(args[1] || '').toLowerCase(), value = args.slice(2).join(' ');
  if (!what) {
    console.log(C.b + d.name + C.x + '  (' + d.key + ', ' + d.pointId + ')  ' + d.state);
    console.log('  ' + [d.model || d.device.product, d.tuner, 'SN ' + (d.device.serial || '—'), 'USB port ' + d.device.port].filter(Boolean).join(' · '));
    console.log('  ' + (d.freqHz / 1e6).toFixed(4) + ' MHz, ' + FORMATS[d.format] + ', gain ' + (d.gainDb == null ? 'auto' : d.gainDb + ' dB') + ', ' + (d.ppm || 0) + ' ppm, squelch ' + d.squelchDb + ' dB' + (d.biasTee ? ', bias tee on' : ''));
    const label = { freqHz: 'freq', gainDb: 'gain', squelchDb: 'squelch', biasTee: 'bias-tee', enabled: 'on/off' };
    console.log('  ' + (d.own.length ? 'its own: ' + d.own.map(f => label[f] || f).join(', ') + '; the rest shared' : 'all settings shared') + (d.enabled ? '' : C.y + ' — turned off' + C.x));
    return;
  }
  if (what === 'on' || what === 'off') { value = what === 'on' ? 'shared' : 'off'; what = 'enabled'; }
  const field = STICK_SETTINGS[what];
  if (!field) throw new Error('rpi-alert sdr <stick> freq|format|gain|ppm|squelch|bias-tee|name <value>, or rpi-alert sdr <stick> on|off');
  if (value === '') throw new Error(what + ': which value? ("shared" for the setting all sticks share)');
  const v = stickValue(field, value);
  const list = (await api('/api/config')).config.receivers.sdrDevices || [];
  // Its entry by key; one 0.4 made by serial is copied into it (and left for any other stick with that serial).
  const entry = Object.assign({}, list.find(e => e.key === d.key) || list.find(e => !e.key && e.serial === d.device.serial) || {}, { key: d.key });
  delete entry.serial;
  if (v === undefined) delete entry[field]; else entry[field] = v;
  const next = list.filter(e => e.key !== d.key).concat(Object.keys(entry).length > 1 ? [entry] : []);
  const r = await post('/api/config', { config: { receivers: { sdrDevices: next } } });
  const shown = v === undefined ? 'back to the shared setting' : field === 'freqHz' ? (v / 1e6).toFixed(4) + ' MHz' : field === 'format' ? FORMATS[v]
    : field === 'gainDb' && v === null ? 'auto' : field === 'biasTee' ? (v ? 'on' : 'off') : String(v);
  console.log(r.changed.length ? 'Saved: ' + d.name + ' — ' + (field === 'enabled' ? (v === false ? 'turned off' : 'turned on') : what + ' ' + shown) + '.' : 'Unchanged.');
}

async function ask(rl, q, def) {
  const a = (await rl.question(q + (def != null && def !== '' ? ' [' + def + ']' : '') + ': ')).trim();
  return a === '' ? def : a;
}

async function token(t) {
  if (!t) {
    const rl = require('node:readline/promises').createInterface({ input: process.stdin, output: process.stdout });
    t = await ask(rl, 'MegaNet ingest token (mgn_… from MegaNet\'s Admin tab → Ingest tokens; or press Enter and this Pi asks MegaNet for one)', '');
    rl.close();
    if (!t) return requestToken({});
  }
  if (!t) return;
  const check = await post('/api/token/test', { token: t });
  if (!check.ok) { console.log(C.r + 'Not saved: ' + check.error + C.x); process.exitCode = 1; return; }
  await post('/api/config', { config: { meganet: { token: t, enabled: true } } });
  console.log(C.g + 'Saved.' + C.x + (check.label ? ' MegaNet knows this token as "' + check.label + '".' : '') + (check.note ? ' ' + check.note : ''));
}

async function password() {
  const rl = require('node:readline/promises').createInterface({ input: process.stdin, output: process.stdout, terminal: true });
  const pw = await ask(rl, 'New web page password (6+ characters; blank to cancel)', '');
  rl.close();
  if (!pw) return;
  await post('/api/password', { password: pw });
  console.log('Saved. The web page will ask for it from other computers; this Pi\'s own screen does not.');
}

async function setup() {
  const rl = require('node:readline/promises').createInterface({ input: process.stdin, output: process.stdout });
  const c = (await api('/api/config')).config;
  console.log(C.b + 'RPi ALERT setup' + C.x + ' — Enter keeps the value in [brackets].\n');
  const name = await ask(rl, 'Name for this base station in MegaNet', c.name || '');
  console.log('\nThe MegaNet ingest token: one per base station. Paste one from MegaNet\'s Admin tab → Ingest tokens,');
  console.log('or press Enter and this Pi asks MegaNet for one — an administrator approves it from their phone.');
  const tok = await ask(rl, 'Ingest token' + (c.meganet.tokenSet ? ' (one is set: ' + c.meganet.token + ' — Enter keeps it)' : ' (Enter: ask MegaNet)'), '');
  console.log('\nWhere is it? Type "lat, lon" (e.g. -27.4698, 153.0251), a station number or name, or leave blank.');
  console.log('A USB GPS, when one is plugged in, is used instead automatically.');
  const where = await ask(rl, 'Location', c.location.lat != null ? c.location.lat + ', ' + c.location.lon : '');
  console.log('\nRTL-SDR: the ALERT channel, and the frame format the network sends (binary for the 151.5 MHz network; enhanced_iflows for an ERT-A2 set to it).');
  const sticks = (await api('/api/status')).devices.sdrs;
  if (sticks.length > 1) console.log('This is for every stick; to give one of the ' + sticks.length + ' its own channel afterwards: rpi-alert sdr ' + sticks[1].n + ' freq <MHz>');
  const mhz = await ask(rl, 'Frequency, MHz', (c.receivers.sdr.freqHz / 1e6).toString());
  const fmt = await ask(rl, 'Format (binary / enhanced_iflows / ascii)', c.receivers.sdr.format.toLowerCase());
  const audio = await ask(rl, 'Audio (auto / live / synth / beep / off)', c.audio.mode);
  rl.close();
  const patch = { name, receivers: { sdr: { freqHz: Math.round(Number(mhz) * 1e6), format: String(fmt).toUpperCase() } }, audio: { mode: audio } };
  if (where && where !== (c.location.lat != null ? c.location.lat + ', ' + c.location.lon : '')) {
    const m = /^\s*(-?\d+(?:\.\d+)?)\s*[, ]\s*(-?\d+(?:\.\d+)?)\s*$/.exec(where);
    if (m) {
      let lat = Number(m[1]), lon = Number(m[2]);
      if (Math.abs(lat) > 90 && Math.abs(lon) <= 90) [lat, lon] = [lon, lat];
      patch.location = { source: 'manual', lat, lon };
    } else {
      const hits = (await api('/api/stations/search?q=' + encodeURIComponent(where))).stations;
      if (hits.length === 1 && hits[0].lat != null) patch.location = { source: 'station', station: hits[0].id, stationName: hits[0].name, lat: hits[0].lat, lon: hits[0].lon };
      else console.log(C.y + 'Location not set: ' + (hits.length ? hits.length + ' stations match "' + where + '" — be more specific' : 'no station matches "' + where + '"') + C.x);
    }
  }
  const r = await post('/api/config', { config: patch });
  console.log('\nSaved' + (r.changed.length ? ': ' + r.changed.join(', ') : ' (nothing changed)') + '.');
  if (tok) await token(tok);
  const s = await api('/api/status');
  if (!s.passwordSet) console.log('\nSet a web page password too: rpi-alert password');
  console.log('\nCheck it with: rpi-alert status');
  // Last, because it waits for an administrator.
  if (!tok && !c.meganet.tokenSet) await requestToken({});
}

// Ask MegaNet for this Pi's token (MegaNet 0048): show the code and a QR code
// of the link to the request, then wait for an administrator. Ctrl+C stops the
// waiting here, not the asking: the agent goes on asking, and saves the token
// when it is approved.
async function requestToken(o) {
  if (o.cancel) {
    const r = await post('/api/token/request/cancel', {});
    console.log(r.last ? r.last.message : 'Nothing was waiting.');
    return;
  }
  const before = await api('/api/status');
  if (before.meganet.tokenSet && !before.meganet.tokenRefused && (before.tokenRequest || {}).state !== 'pending') {
    console.log(C.d + 'This Pi has a working token already' + (before.meganet.label ? ' ("' + before.meganet.label + '")' : '') + '; an approved request replaces it.' + C.x);
  }
  const t = await post('/api/token/request', {});
  if (t.state !== 'pending') {
    console.log(C.r + ((t.last && t.last.message) || 'MegaNet did not take the request.') + C.x);
    process.exitCode = 1;
    return;
  }
  const QR = require(path.join(__dirname, '..', 'web', 'qr.js'));
  console.log('\n' + C.b + 'MegaNet has been asked for this Pi\'s token' + C.x + ' (as "' + t.label + '"). The code is\n');
  console.log('      ' + C.b + t.code + C.x + '\n');
  try { QR.text(t.link, { invert: o.invert }).forEach(l => console.log('  ' + l)); } catch (_) {}
  console.log('\nOn a phone or computer signed in to MegaNet as an administrator, scan the QR code');
  console.log('or open ' + t.link.split('#')[0] + ' → Admin → Ingest tokens. Check the request shows');
  console.log(t.code + ', then press Approve. It expires in ' + Math.max(1, Math.round(t.expiresInS / 60)) + ' min.\n');
  console.log(C.d + 'Waiting… (Ctrl+C stops watching; the Pi goes on asking — rpi-alert request-token --cancel stops it)' + C.x);
  for (;;) {
    await new Promise(r => setTimeout(r, 2000));
    let tr;
    try { tr = (await api('/api/status')).tokenRequest || {}; } catch (_) { continue; }
    if (tr.state === 'pending' || tr.state === 'asking') continue;
    const last = tr.last || {};
    console.log((last.status === 'approved' ? C.g : C.y) + (last.message || 'The request has ended.') + C.x);
    if (last.status !== 'approved') process.exitCode = 1;
    return;
  }
}

async function readings(n) {
  const r = await api('/api/readings?limit=' + n);
  for (const x of r.readings.slice().reverse()) {
    console.log(new Date(x.t).toISOString() + ' ' + x.protocol + ' ' + (x.fmt || '-') + ' ' + x.alert_id + '=' + x.value_raw + ' (' + x.eng + ') ' + ((x.station && x.station.name) || '') + ' [' + x.receiver + ']');
  }
}

async function showLog(n) {
  const r = await api('/api/log?n=' + n);
  for (const l of r.lines) console.log(new Date(l.t).toISOString() + ' ' + l.level.toUpperCase().padEnd(5) + ' [' + l.tag + '] ' + l.msg);
}

main().catch((e) => { console.error('rpi-alert: ' + (e && e.message || e)); process.exit(1); });
