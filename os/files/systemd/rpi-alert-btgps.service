[Unit]
Description=RPi ALERT Bluetooth GPS link (/dev/rpi-alert-gps)
Documentation=https://github.com/cdomotor-g/RPi_ALERT/blob/main/docs/configuration.md
# Turned on by gps_bluetooth in rpi-alert.conf, which writes the settings file.
ConditionPathExists=/etc/rpi-alert/bluetooth-gps.conf
After=bluetooth.service hciuart.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/rpi-alert/libexec/rpi-alert-btgps
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
