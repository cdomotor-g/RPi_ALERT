# RPi ALERT — settings applied when the Pi boots.
#
# To use: copy this file to rpi-alert.conf (same folder: the SD card's "bootfs"
# partition, next to config.txt), fill in what you need, delete the rest, and
# put the card back in the Pi. On the next boot the settings are applied, this
# file is renamed rpi-alert.conf.applied with the secrets blanked out, and what
# happened is written to rpi-alert-boot.log beside it.
#
# The flasher page writes this file for you:
#   https://cdomotor-g.github.io/RPi_ALERT/
#
# Lines starting with # are ignored. Everything can also be set later on the
# Pi's web page (http://rpi-alert.local/) or with `rpi-alert setup` over SSH.

# ── MegaNet ─────────────────────────────────────────────────────────────────
# The ingest token for this base station: one per Pi. Easiest: leave token out
# and say request_token = yes — at boot the Pi asks MegaNet for one, and an
# administrator approves it on MegaNet's Admin tab → Ingest tokens (on their
# phone; the code to check is on http://rpi-alert.local/ and in
# `rpi-alert status`). Or paste one made there (shown once):
#token = mgn_xxxxxxxxxxxxxxxxxxxxxxxx
request_token = yes

# What MegaNet calls this base station.
#name = Bench Pi

# ── Where it is ─────────────────────────────────────────────────────────────
# Decimal degrees. Recorded in MegaNet as approximate; a USB GPS fix, when one
# is plugged in, is used instead and recorded as exact.
#latitude = -27.4698
#longitude = 153.0251
#use_gps = yes

# A Bluetooth GPS, for a mobile unit: an Emlid Reach with Position output set
# to Bluetooth, NMEA (ReachView), Bluetooth on and discoverable. The Pi pairs
# with it, keeps it connected and follows it as it moves.
#gps_bluetooth = 58:A8:39:01:93:61
#gps_bluetooth_pin = 123456

# ── RTL-SDR ─────────────────────────────────────────────────────────────────
# For every stick. With several sticks, each can have channels of its own once
# it has been plugged in: the web page (Settings → RTL-SDR → Each stick), or
# `rpi-alert sdr 2 freq 151.525` over SSH.
#sdr_frequency_mhz = 151.5
# One stick hears several channels at once when they are within about 1.9 MHz
# of each other — each is a receiver of its own in MegaNet. List them, the
# stick's own first; a channel sent in another format has it after it:
#sdr_frequency_mhz = 151.5, 151.525, 151.95, 152.4 eif
# Or just the more channels, beside sdr_frequency_mhz (none for none):
#sdr_more_channels_mhz = 151.525, 152.4
# binary (the 151.5 MHz networks) | enhanced_iflows (an ERT-A2 set to it) | ascii
#sdr_format = binary
# A number in dB, or auto
#sdr_gain_db = 29.7
#sdr_ppm = 0
# 4.5 V on the antenna socket, for an LNA that wants it
#sdr_bias_tee = no

# ── Audio: hear each ALERT burst on a speaker in the audio jack ────────────
# auto | live | synth | beep | off
#audio = auto
#audio_volume = 80

# ── Screen ──────────────────────────────────────────────────────────────────
# auto (dashboard on a connected monitor) | on | off (text console only)
#kiosk = auto

# ── Web page password (stored hashed; removed from the card) ───────────────
#web_password = choose-something

# ── Getting in later: SSH ───────────────────────────────────────────────────
# Every RPi ALERT has the maintenance account "alert": no password, SSH keys
# only. Give it yours (a line each — these replace the ones a card gave before;
# ssh_key = none clears them), and/or the GitHub accounts whose keys may log in.
#ssh_key = ssh-ed25519 AAAA… you@laptop
#ssh_github = your-github-name, a-colleague
# MegaNet's team keys (its administrators keep the list) may log in too:
#ssh_meganet_keys = yes
# Keys from GitHub and MegaNet work from private networks only, unless: any
#ssh_from = private
# SSH password login: off for keys only (left as Raspberry Pi Imager set it if absent)
#ssh_password_login = off
# Locked out? A password for "alert" — the console (and SSH, if password login
# is on). Removed from the card once applied; alert_password = none takes it away.
#alert_password = choose-something-long

# ── MegaNet's Base Stations tab ─────────────────────────────────────────────
# The Pi checks in with MegaNet once a minute (MegaNet never connects to it).
# manage: health, settings, restarts, updates | report: health only | off
#remote_management = manage

# ── The Pi's own Wi-Fi network ──────────────────────────────────────────────
# Where there is no network, a phone joins this and opens http://10.42.0.1/.
# auto: up after three minutes with no network, gone the moment one appears.
#hotspot = auto
#hotspot_ssid = Mt Mee survey
#hotspot_password = choose-one-8-to-63-chars

# ── Site survey ─────────────────────────────────────────────────────────────
# Leave this Pi at a candidate site for a few days: it starts listening at this
# power-up, keeps everything on the card, and sends what it heard to MegaNet
# (as receptions — its readings too only if survey_readings = yes) when it is
# next on a network. docs/survey.md has the kit list. A GPS, or a battery RTC,
# keeps the time through a power cut with no internet.
#survey = Mt Mee candidate repeater
#survey_hours = 72
#survey_readings = no

# ── The Pi ──────────────────────────────────────────────────────────────────
#timezone = Australia/Brisbane
#hostname = rpi-alert
#ssh = on
# Install new RPi ALERT releases by themselves, nightly between 3 and 4 am (or
# turn this on in the web page's Settings → System). update = now installs the
# latest release once, at this boot. Either way no re-flashing is needed.
#auto_update = on
#update = now

# A Wi-Fi network to join. Raspberry Pi Imager's "customisation" can do this
# too (and set the user and password) — use one or the other.
#wifi_country = AU
#wifi_ssid = MyNetwork
#wifi_password = its-password
