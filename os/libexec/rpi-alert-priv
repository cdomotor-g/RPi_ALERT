#!/bin/bash
# rpi-alert-priv — the few things the RPi ALERT agent (user rpi-alert) needs
# root for. sudoers lets the agent run this one program; this program takes a
# fixed list of verbs and checks every argument before acting on it.
#
#   kiosk start|stop          the full-screen dashboard on a connected monitor
#   reboot | poweroff | restart-agent
#   set-time <unix seconds>   from a GPS fix or the RTC, when there has been no NTP
#                             (refused while NTP has the time, and outside 2025–2099)
#   rtc-sync                  write the system time to the battery RTC (Pi 5, DS3231…),
#                             while NTP or a GPS says it is right
#   timezone <Area/City>
#   hostname <name>
#   net-status                interfaces and addresses
#   wifi-scan                 nearby networks (nmcli terse output)
#   wifi-connect <ssid> [<password>]
#   hotspot-up <ssid> <password>   the Pi's own Wi-Fi network: an access point, the Pi
#                             at 10.42.0.1 (whether it is up the agent reads without root)
#   hotspot-down
#   wifi-rejoin               take the hotspot down and join a saved Wi-Fi network that is
#                             in range, by name (exit 3: none in range; 4: none would have it)
#   net-reconnect             renew each network connection the Pi has (not the hotspot)
#   net-restart               restart NetworkManager
#   update-check              is there a newer RPi ALERT release?
#   update-install            install it now (rpi-alert-update.service, in the background)
#   update-auto on|off        the nightly install-if-newer timer
#   update-status             whether the timer is on and an install is running (the
#                             outcome the agent reads itself: /var/lib/rpi-alert-update/status.json)
#   access-status             who may log in over SSH, and how (JSON; docs/access.md)
#   access-sync               fetch the GitHub and MegaNet key lists now
#   access-set meganet on|off | from private|any | password on|off|unchanged | ssh on|off
#                             nothing here puts a key on the list: keys come only
#                             from the SD card, sudo rpi-alert access, or the lists
#                             root itself fetches (rpi-alert-access)
set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/bin

die() { echo "$*" >&2; exit 2; }
verb=${1:-}; shift || true

case "$verb" in
  kiosk)
    case "${1:-}" in
      start)
        command -v cage >/dev/null || die "the kiosk is not installed (sudo /opt/rpi-alert/os/install.sh --kiosk)"
        exec systemctl start rpi-alert-kiosk.service ;;
      stop) exec systemctl stop rpi-alert-kiosk.service ;;
      *) die "kiosk start|stop" ;;
    esac ;;
  reboot) exec systemctl reboot ;;
  poweroff) exec systemctl poweroff ;;
  restart-agent) exec systemctl restart rpi-alert.service ;;
  set-time)
    [[ "${1:-}" =~ ^[0-9]{10}$ ]] || die "set-time <unix seconds>"
    # A GPS with the week-rollover bug reports a date ~20 years back: never take one.
    (( $1 > 1735689600 )) || die "refusing a time before 2025"
    (( $1 < 4102444800 )) || die "refusing a time after 2099"
    # Network time, once it has answered, is better than anything the agent
    # could pass in — and a GPS or serial device the agent reads could be lying.
    [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" != yes ] || die "the clock is set over the network (NTP); not changing it"
    exec date -s "@$1" ;;
  rtc-sync)
    [ -e /dev/rtc0 ] || die "no RTC (/dev/rtc0)"
    command -v hwclock >/dev/null || die "hwclock is not installed (apt install util-linux-extra)"
    exec hwclock --systohc --utc ;;
  timezone)
    tz=${1:-}
    if ! [[ "$tz" =~ ^[A-Za-z_]+(/[A-Za-z0-9_+-]+){0,2}$ ]] || ! [ -f "/usr/share/zoneinfo/$tz" ]; then die "unknown time zone: $tz"; fi
    exec timedatectl set-timezone "$tz" ;;
  hostname)
    h=${1:-}
    [[ "$h" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || die "hostname: lower-case letters, digits and dashes"
    if command -v raspi-config >/dev/null; then exec raspi-config nonint do_hostname "$h"; fi
    exec hostnamectl set-hostname "$h" ;;
  net-status)
    if command -v nmcli >/dev/null; then
      nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device 2>/dev/null | sed 's/\\:/:/g'
      echo
    fi
    ip -brief -4 address 2>/dev/null | grep -v '^lo ' ;;
  wifi-scan)
    command -v nmcli >/dev/null || die "NetworkManager (nmcli) is not installed"
    nmcli radio wifi on >/dev/null 2>&1 || true
    exec nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list --rescan yes ;;
  wifi-connect)
    ssid=${1:-}; pw=${2:-}
    if [ -z "$ssid" ] || [ ${#ssid} -gt 32 ]; then die "wifi-connect <ssid> [<password>]"; fi
    [ -z "$pw" ] || { [ ${#pw} -ge 8 ] && [ ${#pw} -le 63 ]; } || die "a Wi-Fi password is 8–63 characters"
    command -v nmcli >/dev/null || die "NetworkManager (nmcli) is not installed"
    nmcli radio wifi on >/dev/null 2>&1 || true
    if [ -n "$pw" ]; then exec nmcli --wait 45 device wifi connect "$ssid" password "$pw"
    else exec nmcli --wait 45 device wifi connect "$ssid"; fi ;;
  hotspot-up)
    ssid=${1:-}; pw=${2:-}
    re='^[A-Za-z0-9._ -]{1,32}$'
    [[ "$ssid" =~ $re ]] || die "hotspot-up <ssid: 1-32 letters, digits, spaces, dots, dashes, underscores> <password>"
    printf '%s' "$pw" | LC_ALL=C grep -qE '^[[:graph:]]{8,63}$' || die "a hotspot password is 8-63 characters, no spaces"
    command -v nmcli >/dev/null || die "NetworkManager (nmcli) is not installed"
    dev=$(nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}')
    [ -n "$dev" ] || die "this Pi has no Wi-Fi"
    rfkill unblock wifi >/dev/null 2>&1 || true
    nmcli radio wifi on >/dev/null 2>&1 || true
    if nmcli -t -f NAME connection show 2>/dev/null | grep -qx rpi-alert-hotspot; then
      nmcli connection modify rpi-alert-hotspot connection.interface-name "$dev" 802-11-wireless.ssid "$ssid" wifi-sec.psk "$pw" || exit 1
    else
      # NetworkManager's "shared" method: its own DHCP for whoever joins, the Pi at 10.42.0.1.
      nmcli connection add type wifi ifname "$dev" con-name rpi-alert-hotspot autoconnect no ssid "$ssid" \
        802-11-wireless.mode ap 802-11-wireless.band bg ipv4.method shared ipv4.addresses 10.42.0.1/24 ipv6.method disabled \
        wifi-sec.key-mgmt wpa-psk wifi-sec.proto rsn wifi-sec.pairwise ccmp wifi-sec.group ccmp wifi-sec.psk "$pw" || exit 1
    fi
    exec nmcli --wait 30 connection up rpi-alert-hotspot ;;
  hotspot-down)
    command -v nmcli >/dev/null || die "NetworkManager (nmcli) is not installed"
    if nmcli -t -f NAME connection show --active 2>/dev/null | grep -qx rpi-alert-hotspot; then exec nmcli connection down rpi-alert-hotspot; fi
    exit 0 ;;
  # The three below are what the agent does by itself when it has lost touch
  # with MegaNet (lib/keeper.js, lib/hotspot.js). None takes an argument:
  # which networks, and their passwords, are NetworkManager's own.
  wifi-rejoin)
    command -v nmcli >/dev/null || die "NetworkManager (nmcli) is not installed"
    dev=$(nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}')
    [ -n "$dev" ] || die "this Pi has no Wi-Fi"
    hs=$(nmcli -g connection.uuid connection show rpi-alert-hotspot 2>/dev/null || true)
    if nmcli -t -f NAME connection show --active 2>/dev/null | grep -qx rpi-alert-hotspot; then nmcli connection down rpi-alert-hotspot >/dev/null 2>&1 || true; fi
    nmcli radio wifi on >/dev/null 2>&1 || true
    # What is in the air now, a name a line.
    seen=$(nmcli --escape no -t -f SSID device wifi list ifname "$dev" --rescan yes 2>/dev/null || true)
    # A radio that has just stopped being an access point may refuse the first scan.
    if [ -z "$(printf '%s' "$seen" | tr -d '[:space:]')" ]; then
      sleep 4
      seen=$(nmcli --escape no -t -f SSID device wifi list ifname "$dev" --rescan auto 2>/dev/null || true)
    fi
    tried=0
    # Saved networks, the one used most recently first. NetworkManager left to
    # itself stops trying a network after some failures; asked by name it tries.
    while IFS=: read -r _ uuid type; do
      if [ "$type" != 802-11-wireless ] || [ -z "$uuid" ] || [ "$uuid" = "$hs" ]; then continue; fi
      [ "$(nmcli -g 802-11-wireless.mode connection show uuid "$uuid" 2>/dev/null)" = ap ] && continue
      ssid=$(nmcli --escape no -g 802-11-wireless.ssid connection show uuid "$uuid" 2>/dev/null) || continue
      [ -n "$ssid" ] || continue
      # In range — or hidden, which a scan never shows.
      if ! printf '%s\n' "$seen" | grep -Fxq -- "$ssid" && [ "$(nmcli -g 802-11-wireless.hidden connection show uuid "$uuid" 2>/dev/null)" != yes ]; then continue; fi
      tried=$((tried + 1))
      if nmcli --wait 30 connection up uuid "$uuid" ifname "$dev" >/dev/null 2>&1; then echo "joined $ssid"; exit 0; fi
      [ "$tried" -ge 3 ] && break
    done < <(nmcli -t -f TIMESTAMP,UUID,TYPE connection show 2>/dev/null | sort -t: -k1,1nr)
    if [ "$tried" = 0 ]; then echo "no saved Wi-Fi network is in range" >&2; exit 3; fi
    echo "in range, but could not be joined: $tried saved Wi-Fi network(s)" >&2; exit 4 ;;
  net-reconnect)
    command -v nmcli >/dev/null || die "NetworkManager (nmcli) is not installed"
    hs=$(nmcli -g connection.uuid connection show rpi-alert-hotspot 2>/dev/null || true)
    n=0; ok=0
    while IFS=: read -r dev type state uuid; do
      case "$type" in wifi|ethernet) ;; *) continue ;; esac
      case "$state" in connected*) ;; *) continue ;; esac
      if [ -z "$uuid" ] || [ "$uuid" = "$hs" ]; then continue; fi
      n=$((n + 1))
      if nmcli --wait 45 connection up uuid "$uuid" ifname "$dev" >/dev/null 2>&1; then ok=$((ok + 1)); fi
    done < <(nmcli -t -f DEVICE,TYPE,STATE,CON-UUID device 2>/dev/null)
    [ "$n" -gt 0 ] || die "there is no network connection to renew"
    [ "$ok" -gt 0 ] || die "the network connection could not be renewed"
    echo "renewed $ok of $n"; exit 0 ;;
  net-restart)
    # Only where NetworkManager already runs the network: never start it beside another.
    systemctl is-active --quiet NetworkManager.service || die "NetworkManager does not run this Pi's network"
    systemctl restart NetworkManager.service || die "NetworkManager could not be restarted"
    if command -v nmcli >/dev/null; then nmcli radio wifi on >/dev/null 2>&1 || true; fi
    echo "NetworkManager restarted"; exit 0 ;;
  update-check) exec /opt/rpi-alert/libexec/rpi-alert-update --check ;;
  update-install) exec systemctl start --no-block rpi-alert-update.service ;;
  update-auto)
    case "${1:-}" in
      on) exec systemctl enable --now rpi-alert-update-auto.timer ;;
      off) exec systemctl disable --now rpi-alert-update-auto.timer ;;
      *) die "update-auto on|off" ;;
    esac ;;
  update-status)
    # Two lines: the timer (enabled|disabled), the installer (running|idle). The
    # last outcome is root's file, readable by all; the agent reads it itself
    # (it used to be read here, from the agent's own directory, as root).
    systemctl is-enabled rpi-alert-update-auto.timer 2>/dev/null || echo disabled
    if systemctl is-active --quiet rpi-alert-update.service || systemctl is-active --quiet rpi-alert-update-auto.service; then echo running; else echo idle; fi ;;
  access-status) exec /usr/bin/node /opt/rpi-alert/bin/rpi-alert-access status ;;
  # Through its own unit, so the hourly timer and this share one log
  # (journalctl -u rpi-alert-access); start waits for the oneshot to finish.
  access-sync) exec systemctl start rpi-alert-access.service ;;
  access-set)
    case "${1:-}:${2:-}" in
      meganet:on|meganet:off|from:private|from:any|password:on|password:off|password:unchanged|ssh:on|ssh:off) ;;
      *) die "access-set meganet on|off | from private|any | password on|off|unchanged | ssh on|off" ;;
    esac
    exec /usr/bin/node /opt/rpi-alert/bin/rpi-alert-access set "$1" "$2" ;;
  *) die "unknown verb: $verb" ;;
esac
